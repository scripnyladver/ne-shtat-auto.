
import 'package:flutter/material.dart';
import 'package:yandex_maps_mapkit/yandex_map.dart';

import 'main.dart' show mapkitAvailable;

const Color _mapBackground = Color(0xFF080A0F);
const Color _mapAccent = Color(0xFF8B7CFF);

class CockpitMapScreen extends StatefulWidget {
  const CockpitMapScreen({super.key});

  @override
  State<CockpitMapScreen> createState() => _CockpitMapScreenState();
}

class _CockpitMapScreenState extends State<CockpitMapScreen> {
  bool _mapCreated = false;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: _mapBackground,
      body: SafeArea(
        child: Column(
          children: [
            Padding(
              padding: const EdgeInsets.fromLTRB(18, 12, 18, 12),
              child: Row(
                children: [
                  const Icon(
                    Icons.navigation_rounded,
                    color: _mapAccent,
                    size: 24,
                  ),
                  const SizedBox(width: 10),
                  const Expanded(
                    child: Column(
                      crossAxisAlignment: CrossAxisAlignment.start,
                      children: [
                        Text(
                          'НАВИГАЦИЯ',
                          style: TextStyle(
                            color: Colors.white,
                            fontWeight: FontWeight.w800,
                            letterSpacing: 2,
                            fontSize: 14,
                          ),
                        ),
                        SizedBox(height: 3),
                        Text(
                          'YANDEX MAPKIT',
                          style: TextStyle(
                            color: Colors.white54,
                            fontSize: 9,
                            letterSpacing: 2,
                          ),
                        ),
                      ],
                    ),
                  ),
                  Container(
                    padding: const EdgeInsets.symmetric(
                      horizontal: 10,
                      vertical: 6,
                    ),
                    decoration: BoxDecoration(
                      color: _mapAccent.withOpacity(.14),
                      borderRadius: BorderRadius.circular(20),
                    ),
                    child: Text(
                      mapkitAvailable
                          ? (_mapCreated ? 'КАРТА АКТИВНА' : 'ЗАГРУЗКА')
                          : 'НЕТ API-КЛЮЧА',
                      style: const TextStyle(
                        color: _mapAccent,
                        fontSize: 9,
                        fontWeight: FontWeight.bold,
                      ),
                    ),
                  ),
                ],
              ),
            ),
            Expanded(
              child: ClipRRect(
                borderRadius: BorderRadius.circular(20),
                child: mapkitAvailable
                    ? Stack(
                        children: [
                          Positioned.fill(
                            child: YandexMap(
                              onMapCreated: (mapWindow) {
                                if (mounted) {
                                  setState(() => _mapCreated = true);
                                }
                              },
                            ),
                          ),
                          if (!_mapCreated)
                            const Positioned.fill(
                              child: IgnorePointer(
                                child: Center(
                                  child: CircularProgressIndicator(
                                    color: _mapAccent,
                                  ),
                                ),
                              ),
                            ),
                        ],
                      )
                    : Container(
                        color: const Color(0xFF171C26),
                        alignment: Alignment.center,
                        padding: const EdgeInsets.all(24),
                        child: const Column(
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Icon(
                              Icons.map_outlined,
                              color: _mapAccent,
                              size: 56,
                            ),
                            SizedBox(height: 16),
                            Text(
                              'Карта пока недоступна',
                              style: TextStyle(
                                color: Colors.white,
                                fontSize: 17,
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                            SizedBox(height: 8),
                            Text(
                              'Проверь MAPKIT_API_KEY в настройках GitHub Secrets и пересобери приложение.',
                              textAlign: TextAlign.center,
                              style: TextStyle(
                                color: Colors.white54,
                                fontSize: 12,
                              ),
                            ),
                          ],
                        ),
                      ),
              ),
            ),
            const Padding(
              padding: EdgeInsets.fromLTRB(16, 10, 16, 12),
              child: Row(
                children: [
                  Icon(
                    Icons.info_outline,
                    color: Colors.white38,
                    size: 16,
                  ),
                  SizedBox(width: 8),
                  Expanded(
                    child: Text(
                      'Карта MapKit. Масштабирование и перемещение доступны жестами.',
                      style: TextStyle(
                        color: Colors.white54,
                        fontSize: 10,
                      ),
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }
}
